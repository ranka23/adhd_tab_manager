{
  "name": "adhd-tab-manager",
  "version": "1.0.1",
  "description": "A browser extension designed for ADHD brains — minimal clutter, one-action-at-a-time, dopamine-friendly tab management",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-chrome.mjs",
    "build:firefox": "vite build && node scripts/build-chrome.mjs && node scripts/build-firefox.mjs",
    "build:all": "tsc && vite build && node scripts/build-chrome.mjs && node scripts/build-firefox.mjs",
    "build:safari": "pnpm build:all && node scripts/build-safari.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx,.mjs,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.mjs,.js --fix",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.5",
    "web-ext": "^8.2.0"
  }
}
